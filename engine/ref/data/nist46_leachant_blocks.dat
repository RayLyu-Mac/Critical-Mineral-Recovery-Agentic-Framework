# NIST46 leachant blocks for PHREEQC. Layer on sit.dat.
# sit.dat native ligands are NOT redefined.
# Custom species use -gamma 1e7 0.0 (Davies-like; SIT epsilon = 0).

# citric: sit.dat native (Cit)
# oxalic: sit.dat native (Ox)
# --- malic (L-Hydroxybutanedioic acid (Hydroxysuccinic acid)(Malic acid)) NIST46 fill; SIT epsilon = 0 ---
SOLUTION_MASTER_SPECIES
Malate         Malate-2       0              Malate         132.0716
SOLUTION_SPECIES
Malate-2 = Malate-2
    log_k 0
    -gamma 1e7 0.0
Malate-2 + H+ = HMalate-
    log_k 5.0970
    -gamma 1e7 0.0
Malate-2 + 2 H+ = H2Malate
    log_k 8.5560
    -gamma 1e7 0.0
    # NIST46_I0.1 [ML]/[M][L] metal=Li I=0.1_fallback
Li+ + Malate-2 = LiMalate-
    log_k 0.3800
    -gamma 1e7 0.0
    # NIST46_I0.1 [ML]/[M][L] metal=Mn I=0.1_fallback
Mn+2 + Malate-2 = MnMalate
    log_k 2.2400
    -gamma 1e7 0.0

# --- tartaric (D-2,3-Dihydroxybutanedioic acid (D-Tartaric acid)) NIST46 fill; SIT epsilon = 0 ---
