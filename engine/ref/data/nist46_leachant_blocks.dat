Mn+2 + Tartrate-2 + H+ = MnHTartrate+
    log_k 5.5760
    -gamma 1e7 0.0
    # NIST46_I0.0 [ML]/[M][L] metal=Co
Co+2 + Tartrate-2 = CoTartrate
    log_k 3.0500
    -gamma 1e7 0.0
    # NIST46_I0.0 [ML2]/[M][L]2 metal=Co estimated
Co+2 + 2 Tartrate-2 = Co(Tartrate)2-2
    log_k 4.0000
    -gamma 1e7 0.0
    # NIST46_I0.1 [ML]/[M][L] metal=Ni I=0.1_fallback
