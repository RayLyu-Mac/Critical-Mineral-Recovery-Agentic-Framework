Tartrate-2 = Tartrate-2
    log_k 0
    -gamma 1e7 0.0
Tartrate-2 + H+ = HTartrate-
    log_k 4.3660
    -gamma 1e7 0.0
Tartrate-2 + 2 H+ = H2Tartrate
    log_k 7.4020
    -gamma 1e7 0.0
    # NIST46_I0.1 [ML]/[M][L] metal=Li I=0.1_fallback
Li+ + Tartrate-2 = LiTartrate-
    log_k 0.7000
    -gamma 1e7 0.0
    # NIST46_I0.1 [MHL]/[M][HL] metal=Li I=0.1_fallback,estimated
Li+ + Tartrate-2 + H+ = LiHTartrate
    log_k 4.7660
    -gamma 1e7 0.0
    # NIST46_I0.1 [ML]/[M][L] metal=Mn I=0.1_fallback
Mn+2 + Tartrate-2 = MnTartrate
