    # NIST46_I0.0 [ML]/[M][L] metal=Li
Li+ + NH3 = Li(NH3)+
    log_k -0.7000
    -gamma 1e7 0.0
    # NIST46_I0.0 [ML]/[M][L] metal=Co
Co+2 + NH3 = Co(NH3)+2
    log_k 2.0300
    -gamma 1e7 0.0

PHASES
Li2CO3
    Li2CO3 = 2Li+ + CO3-2
    log_k -2.9000
    # source=external_literature_ksp_not_NIST46

# Not added, checked against NIST_SRD_46_ported.db (25 C, I=0 or 0.1 only):
# - Co(NH3)2+2 .. Co(NH3)5+2 exist at 25 C only for I=2 or I=5; I=0 rows are 30 C.
# - Oxalate rows are aqueous ML2, not Ni/Co/Mn oxalate solids.
# - No Li3PO4, FePO4, or Mn phosphate solubility rows.
# sit.dat already defines Ni(NH3)1-4, Mn(NH3)1-2, Co3(PO4)2(s), Ni3(PO4)2(cr).
