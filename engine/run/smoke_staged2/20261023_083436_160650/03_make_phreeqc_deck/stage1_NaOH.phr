TITLE Ligand-free black mass, NaOH, 25 C, 1 kg water
# BM_ADD staged. Reagent NaOH 4 mol. No ligand.
# Deck hydroxides below carry delta_h and do not copy -analytic.

PHASES
Fe(OH)3(s)
    Fe(OH)3 = Fe+3 - 3H+ + 3H2O
    log_k 2.78
    delta_h -88  # delta_h estimated; sit.dat Ferrihydrite(s) has log_k 2.78 and no delta_h
Cu(OH)2(s)
    Cu(OH)2 = Cu+2 - 2H+ + 2H2O
    log_k 8.34
    delta_h -62.764  # delta_h from sit.dat Cu(OH)2(s); log_k is the deck value (sit.dat is 8.64)
Co(OH)2(s)
    Co(OH)2 = Co+2 - 2H+ + 2H2O
    log_k 13.11
    delta_h -93.56  # delta_h from sit.dat Co(OH)2(s,rose2)
Ni(OH)2(s)
    Ni(OH)2 = Ni+2 - 2H+ + 2H2O
    log_k 13.3
    delta_h -84.389  # delta_h from sit.dat Ni(OH)2(s); log_k is the deck value (sit.dat is 11.03)
Mn(OH)2(s)
    Mn(OH)2 = Mn+2 - 2H+ + 2H2O
    log_k 15.28
    delta_h -92  # delta_h estimated; sit.dat Pyrochroite has log_k 15.3 and no delta_h

KNOBS
    -iterations 7000
    -convergence_tolerance 1e-6
    -tolerance             1e-9

# STAGE A
SOLUTION 1 leachate
    temp      25
    pH        7 charge
    water     1
    units     mol/kgw
SELECTED_OUTPUT 1
    -file   C:/Users/super/OneDrive/Desktop/battery-recycle/pipelines/agentloop/EconAgentLoop/engine/run/smoke_staged2/20261023_083436_160650/04_run_phreeqc/stage_A_feed.csv
    -reset  true
    -pH     true
    -pe     true
    -temperature true
    -ionic_strength true
    -totals Al Fe Cu Co Ni Mn Li Na S
    -si Gibbsite Fe(OH)3(s) Cu(OH)2(s) Co(OH)2(s) Ni(OH)2(s) Mn(OH)2(s)
SAVE solution 1
END

SELECTED_OUTPUT 1
    -active false
END

# STAGE 1 staged points
SELECTED_OUTPUT 2
    -file   C:/Users/super/OneDrive/Desktop/battery-recycle/pipelines/agentloop/EconAgentLoop/engine/run/smoke_staged2/20261023_083436_160650/04_run_phreeqc/stage_1_NaOH.csv
    -reset  true
    -pH     true
    -pe     true
    -temperature true
    -ionic_strength true
    -totals Al Fe Cu Co Ni Mn Li Na S
    -equilibrium_phases Gibbsite Fe(OH)3(s) Cu(OH)2(s) Co(OH)2(s) Ni(OH)2(s) Mn(OH)2(s)
    -si Gibbsite Fe(OH)3(s) Cu(OH)2(s) Co(OH)2(s) Ni(OH)2(s) Mn(OH)2(s)
    -active false
USER_PUNCH 2
    -headings seq reagent_cum_mol bm_cum_frac
END

